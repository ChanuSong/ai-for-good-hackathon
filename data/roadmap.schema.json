{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MARO preparation dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "id", "data_mode", "review_status", "scope", "sources", "claims", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {"type": "string", "minLength": 1},
    "id": {"const": "seocho-infertility-preparation"},
    "data_mode": {"const": "official_sources"},
    "review_status": {"enum": ["human_review_pending", "human_reviewed"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["district", "marriage", "household", "stage", "description"],
      "properties": {
        "district": {"const": "seocho"},
        "marriage": {"const": "legal"},
        "household": {"const": "synthetic_foreign_wife_korean_husband"},
        "stage": {"const": "before_treatment"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "reviewer": {"type": ["string", "null"], "minLength": 1},
    "localized": {
      "type": "object", "additionalProperties": false,
      "required": ["ko", "ja"],
      "properties": {"ko": {"$ref": "#/$defs/text"}, "ja": {"$ref": "#/$defs/text"}}
    },
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "checked_at", "updated_at", "checked_by", "human_reviewer"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"},
        "publisher": {"$ref": "#/$defs/text"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "checked_at": {"type": "string", "format": "date"},
        "updated_at": {"type": ["string", "null"], "format": "date"},
        "checked_by": {"$ref": "#/$defs/text"}, "human_reviewer": {"$ref": "#/$defs/reviewer"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "source_ids", "locations", "evidence_status", "human_reviewer"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "text": {"$ref": "#/$defs/localized"},
        "source_ids": {"$ref": "#/$defs/ids", "minItems": 1},
        "locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "evidence_status": {"enum": ["source_checked", "verified", "needs_confirmation", "conflicting"]},
        "human_reviewer": {"$ref": "#/$defs/reviewer"}
      },
      "allOf": [
        {"if": {"properties": {"evidence_status": {"const": "verified"}}}, "then": {"properties": {"human_reviewer": {"$ref": "#/$defs/text"}}}},
        {"if": {"properties": {"evidence_status": {"const": "conflicting"}}}, "then": {"properties": {"source_ids": {"minItems": 2}}}}
      ]
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "reason", "claim_ids", "depends_on", "owner", "status", "applicability", "deadline"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/localized"}, "reason": {"$ref": "#/$defs/localized"},
        "claim_ids": {"$ref": "#/$defs/ids", "minItems": 1}, "depends_on": {"$ref": "#/$defs/ids"},
        "owner": {"enum": ["user", "spouse", "together"]}, "status": {"enum": ["todo", "doing", "done"]},
        "applicability": {"enum": ["applicable", "not_applicable", "needs_confirmation"]},
        "deadline": {"type": "null"}
      }
    }
  }
}
